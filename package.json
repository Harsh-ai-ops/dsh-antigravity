{
  "name": "dsh-antigravity",
  "version": "1.2.1",
  "description": "Native DeepSeek Harness plugin for Google Antigravity (Gemini 3.7 Flash Thinking High & Claude) with multi-account rotation, auto-login, and a live quota badge",
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "antigravity",
    "gemini-3.7",
    "cordis"
  ],
  "author": "Harsh-ai-ops",
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
